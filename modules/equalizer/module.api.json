{
  "id": "equalizer",
  "name": "Equalizer",
  "description": "FFT frequency bar visualizer with spring physics. Bars react to live audio with configurable inertia.",
  "oscPrefix": "eq",
  "oscParams": [
    {
      "address": "/eq/springStiffness",
      "name": "springStiffness",
      "label": "Spring Stiffness",
      "section": "physics",
      "type": "float",
      "default": 0.3,
      "description": "Bar response speed — soft=liquid, stiff=snappy",
      "range": [
        0.05,
        0.7
      ]
    },
    {
      "address": "/eq/springStiffnessUp",
      "name": "springStiffnessUp",
      "label": "Spring Stiffness Up",
      "section": "physics",
      "type": "float",
      "default": 0.5,
      "description": "Attack spring — how fast bars rise on a hit",
      "range": [
        0.1,
        0.9
      ]
    },
    {
      "address": "/eq/damping",
      "name": "damping",
      "label": "Damping",
      "section": "physics",
      "type": "float",
      "default": 0.8,
      "description": "Energy loss per frame — high=overdamped/viscous",
      "range": [
        0.55,
        0.97
      ]
    },
    {
      "address": "/eq/gravity",
      "name": "gravity",
      "label": "Gravity",
      "section": "physics",
      "type": "float",
      "default": 0.002,
      "description": "Constant downward pull on bars",
      "range": [
        0.0001,
        0.005
      ]
    },
    {
      "address": "/eq/fluidDrag",
      "name": "fluidDrag",
      "label": "Fluid Drag",
      "section": "physics",
      "type": "float",
      "default": 0.02,
      "description": "Velocity-squared drag — enhances liquid feel",
      "range": [
        0,
        0.08
      ]
    },
    {
      "address": "/eq/barColor",
      "name": "barColor",
      "label": "Bar Color",
      "section": "params",
      "type": "color",
      "default": "#00ffff",
      "description": "Bar fill colour"
    },
    {
      "address": "/eq/peakColor",
      "name": "peakColor",
      "label": "Peak Color",
      "section": "params",
      "type": "color",
      "default": "#ffffff",
      "description": "Peak hold indicator colour"
    },
    {
      "address": "/eq/glowIntensity",
      "name": "glowIntensity",
      "label": "Glow Intensity",
      "section": "params",
      "type": "float",
      "default": 0.5,
      "description": "Bloom/glow strength",
      "range": [
        0,
        1
      ]
    },
    {
      "address": "/eq/barGap",
      "name": "barGap",
      "label": "Bar Gap",
      "section": "params",
      "type": "float",
      "default": 0.15,
      "description": "Gap between bars as fraction of bar width",
      "range": [
        0,
        0.5
      ]
    },
    {
      "address": "/eq/smoothing",
      "name": "smoothing",
      "label": "Smoothing",
      "section": "params",
      "type": "float",
      "default": 0.8,
      "description": "FFT smoothing — higher = silkier motion",
      "range": [
        0,
        0.95
      ]
    },
    {
      "address": "/eq/fftGain",
      "name": "fftGain",
      "label": "Fft Gain",
      "section": "params",
      "type": "float",
      "default": 1,
      "description": "FFT amplitude scale — tune if bars are too short or tall",
      "range": [
        0.1,
        5
      ]
    },
    {
      "address": "/eq/mirror",
      "name": "mirror",
      "label": "Mirror",
      "section": "effects",
      "type": "boolean",
      "default": false,
      "description": "Mirror bars left-right symmetrically"
    },
    {
      "address": "/eq/rainbow",
      "name": "rainbow",
      "label": "Rainbow",
      "section": "effects",
      "type": "boolean",
      "default": false,
      "description": "Color each bar by its frequency position"
    },
    {
      "address": "/eq/peakHold",
      "name": "peakHold",
      "label": "Peak Hold",
      "section": "effects",
      "type": "boolean",
      "default": true,
      "description": "Show a floating peak indicator per bar"
    },
    {
      "address": "/eq/filled",
      "name": "filled",
      "label": "Filled",
      "section": "effects",
      "type": "boolean",
      "default": true,
      "description": "Filled bars vs outline-only bars"
    }
  ],
  "controller": [
    {
      "id": "physics",
      "title": "Physics",
      "controls": [
        {
          "type": "slider",
          "label": "Spring Stiffness",
          "address": "/eq/springStiffness",
          "min": 0.05,
          "max": 0.7,
          "step": 0.01,
          "default": 0.3
        },
        {
          "type": "slider",
          "label": "Spring Stiffness Up",
          "address": "/eq/springStiffnessUp",
          "min": 0.1,
          "max": 0.9,
          "step": 0.01,
          "default": 0.5
        },
        {
          "type": "slider",
          "label": "Damping",
          "address": "/eq/damping",
          "min": 0.55,
          "max": 0.97,
          "step": 0.01,
          "default": 0.8
        },
        {
          "type": "slider",
          "label": "Gravity",
          "address": "/eq/gravity",
          "min": 0.0001,
          "max": 0.005,
          "step": 0.0001,
          "default": 0.002
        },
        {
          "type": "slider",
          "label": "Fluid Drag",
          "address": "/eq/fluidDrag",
          "min": 0,
          "max": 0.08,
          "step": 0.001,
          "default": 0.02
        }
      ]
    },
    {
      "id": "params",
      "title": "Parameters",
      "controls": [
        {
          "type": "color",
          "label": "Bar Color",
          "address": "/eq/barColor",
          "default": "#00ffff"
        },
        {
          "type": "color",
          "label": "Peak Color",
          "address": "/eq/peakColor",
          "default": "#ffffff"
        },
        {
          "type": "slider",
          "label": "Glow Intensity",
          "address": "/eq/glowIntensity",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.5
        },
        {
          "type": "slider",
          "label": "Bar Gap",
          "address": "/eq/barGap",
          "min": 0,
          "max": 0.5,
          "step": 0.01,
          "default": 0.15
        },
        {
          "type": "slider",
          "label": "Smoothing",
          "address": "/eq/smoothing",
          "min": 0,
          "max": 0.95,
          "step": 0.01,
          "default": 0.8
        },
        {
          "type": "slider",
          "label": "Fft Gain",
          "address": "/eq/fftGain",
          "min": 0.1,
          "max": 5,
          "step": 0,
          "default": 1
        }
      ]
    },
    {
      "id": "effects",
      "title": "Effects",
      "controls": [
        {
          "type": "toggle",
          "label": "Mirror",
          "address": "/eq/mirror",
          "default": false
        },
        {
          "type": "toggle",
          "label": "Rainbow",
          "address": "/eq/rainbow",
          "default": false
        },
        {
          "type": "toggle",
          "label": "Peak Hold",
          "address": "/eq/peakHold",
          "default": true
        },
        {
          "type": "toggle",
          "label": "Filled",
          "address": "/eq/filled",
          "default": true
        }
      ]
    }
  ],
  "baked": [
    {
      "name": "x",
      "value": 0.5,
      "type": "float",
      "description": "Horizontal anchor position (0=left, 1=right)"
    },
    {
      "name": "y",
      "value": 1,
      "type": "int",
      "description": "Vertical anchor position (0=top, 1=bottom)"
    },
    {
      "name": "width",
      "value": 1,
      "type": "float",
      "description": "Width as fraction of canvas"
    },
    {
      "name": "height",
      "value": 0.35,
      "type": "float",
      "description": "Max bar height as fraction of canvas"
    },
    {
      "name": "anchor",
      "value": "bottom-center",
      "type": "float",
      "description": ""
    },
    {
      "name": "orientation",
      "value": "bottom-up",
      "type": "float",
      "description": ""
    },
    {
      "name": "zOrder",
      "value": 0,
      "type": "int",
      "description": "Draw order — lower renders first (behind)"
    },
    {
      "name": "barCount",
      "value": 32,
      "type": "int",
      "description": "Number of frequency bands shown"
    }
  ]
}