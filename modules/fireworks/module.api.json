{
  "id": "fireworks",
  "name": "Fireworks",
  "description": "Audio-reactive particle-burst fireworks that pop at random positions on the canvas, max 3 simultaneously.",
  "oscPrefix": "fw",
  "oscParams": [
    {
      "address": "/fw/baseColor",
      "name": "baseColor",
      "label": "Base Color",
      "section": "params",
      "type": "color",
      "default": "#ffd060",
      "description": "Default firework colour (used unless rainbowMode is on)"
    },
    {
      "address": "/fw/burstSpeed",
      "name": "burstSpeed",
      "label": "Burst Speed",
      "section": "params",
      "type": "int",
      "default": 4,
      "description": "Initial outward velocity of particles",
      "range": [
        1,
        10
      ]
    },
    {
      "address": "/fw/lifespan",
      "name": "lifespan",
      "label": "Lifespan",
      "section": "params",
      "type": "int",
      "default": 70,
      "description": "Frames each firework lives",
      "range": [
        30,
        180
      ]
    },
    {
      "address": "/fw/gravity",
      "name": "gravity",
      "label": "Gravity",
      "section": "params",
      "type": "float",
      "default": 0.15,
      "description": "Downward pull on each particle per frame",
      "range": [
        0,
        0.6
      ]
    },
    {
      "address": "/fw/spawnRate",
      "name": "spawnRate",
      "label": "Spawn Rate",
      "section": "params",
      "type": "float",
      "default": 0.02,
      "description": "Per-frame chance of spawning in an idle slot at silence",
      "range": [
        0,
        0.3
      ]
    },
    {
      "address": "/fw/bassSpawnBoost",
      "name": "bassSpawnBoost",
      "label": "Bass Spawn Boost",
      "section": "params",
      "type": "int",
      "default": 5,
      "description": "Adds bassEnergy * this to spawn chance",
      "range": [
        0,
        15
      ]
    },
    {
      "address": "/fw/spawnOnBeat",
      "name": "spawnOnBeat",
      "label": "Spawn On Beat",
      "section": "effects",
      "type": "boolean",
      "default": true,
      "description": "Force-spawn one firework on every onBeat (if a slot is idle)"
    },
    {
      "address": "/fw/rainbowMode",
      "name": "rainbowMode",
      "label": "Rainbow Mode",
      "section": "effects",
      "type": "boolean",
      "default": false,
      "description": "Pick random RGB per spawn instead of baseColor"
    }
  ],
  "controller": [
    {
      "id": "params",
      "title": "Parameters",
      "controls": [
        {
          "type": "color",
          "label": "Base Color",
          "address": "/fw/baseColor",
          "default": "#ffd060"
        },
        {
          "type": "slider",
          "label": "Burst Speed",
          "address": "/fw/burstSpeed",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 4
        },
        {
          "type": "slider",
          "label": "Lifespan",
          "address": "/fw/lifespan",
          "min": 30,
          "max": 180,
          "step": 1,
          "default": 70
        },
        {
          "type": "slider",
          "label": "Gravity",
          "address": "/fw/gravity",
          "min": 0,
          "max": 0.6,
          "step": 0.01,
          "default": 0.15
        },
        {
          "type": "slider",
          "label": "Spawn Rate",
          "address": "/fw/spawnRate",
          "min": 0,
          "max": 0.3,
          "step": 0.01,
          "default": 0.02
        },
        {
          "type": "slider",
          "label": "Bass Spawn Boost",
          "address": "/fw/bassSpawnBoost",
          "min": 0,
          "max": 15,
          "step": 1,
          "default": 5
        }
      ]
    },
    {
      "id": "effects",
      "title": "Effects",
      "controls": [
        {
          "type": "toggle",
          "label": "Spawn On Beat",
          "address": "/fw/spawnOnBeat",
          "default": true
        },
        {
          "type": "toggle",
          "label": "Rainbow Mode",
          "address": "/fw/rainbowMode",
          "default": false
        }
      ]
    }
  ],
  "baked": [
    {
      "name": "x",
      "value": 0,
      "type": "int",
      "description": "Horizontal anchor (0=left, 1=right)"
    },
    {
      "name": "y",
      "value": 0,
      "type": "int",
      "description": "Vertical anchor (0=top, 1=bottom)"
    },
    {
      "name": "width",
      "value": 1,
      "type": "float",
      "description": "Bounding box width as fraction of canvas"
    },
    {
      "name": "height",
      "value": 1,
      "type": "float",
      "description": "Bounding box height as fraction of canvas"
    },
    {
      "name": "anchor",
      "value": "top-left",
      "type": "string",
      "description": ""
    },
    {
      "name": "zOrder",
      "value": 20,
      "type": "int",
      "description": "Draw order — lower renders behind"
    },
    {
      "name": "particleCount",
      "value": 60,
      "type": "int",
      "description": "Particles per firework — baked at assembly"
    }
  ]
}