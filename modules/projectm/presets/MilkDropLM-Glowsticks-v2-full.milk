per_frame_init_1=vol = 0; p1 = 0;
per_frame_init_2=vx = .2; vy = -0.1;
per_frame_init_3=kx = 0; ky = 0;
per_frame_init_4=
per_frame_1=dec_med = pow (0.96, 30/fps);
per_frame_2=dec_slow = pow (0.98, 30/fps);
per_frame_3=beat = max (max (bass, mid), treb); 
per_frame_4=avg = avg*dec_slow + beat*(1-dec_slow);
per_frame_5=is_beat = above(beat, .5+avg+peak) * above (time, t0+.2);
per_frame_6=t0 = is_beat*time + (1-is_beat)*t0;
per_frame_7=peak = is_beat * beat + (1-is_beat)*peak*dec_med;
per_frame_8=index = (index + is_beat) %16;
per_frame_9=
per_frame_10=q20 = avg;
per_frame_11=q21 = beat;
per_frame_12=q22 = peak;
per_frame_13=q23 = index;
per_frame_14=q24 = is_beat;
per_frame_15=q26 = bass + mid + treb;
per_frame_16=
per_frame_17=k1 =  is_beat*equal(index,0);
per_frame_18=p1 =  k1*(p1+1) + (1-k1)*p1;
per_frame_19=vol = vol*dec_slow + p1*1.5*(1-dec_slow);
per_frame_20=q19 = vol;
per_frame_21=
per_frame_22=p2 = p2*dec_med + q22*dec_med;
per_frame_23=q27 = p2;
per_frame_24=
per_frame_25=movex = movex + vx*(1+vol);
per_frame_26=movey = movey + vy*(1+vol);
per_frame_27=
per_frame_28=oobx = above(movex,-.9) * below(movex,.9);
per_frame_29=ooby = above(movey,-.9) * below(movey,.9);
per_frame_30=
per_frame_31=vx = vx*oobx + (1-oobx)*5*(sin(movex*50)+.5);
per_frame_32=vy = vy*ooby + (1-ooby)*5*(sin(movey*50)+.5);
per_frame_33=
per_frame_34=q1 = movex;
per_frame_35=q2 = movey;
per_frame_36=
per_frame_37=rot1 = rot1 + .02*(vol-.7);
per_frame_38=q31 = rot1;
per_frame_39=
per_frame_40=zoom = 1.3;
per_frame_41=warp = .0;
per_frame_42=
per_frame_43=monitor = index;
warp_1=`shader_body
warp_2=`{
warp_3=`    float t = saturate((bass/bass_att-0.9)*13);
warp_4=`    uv = lerp(uv_orig, uv, t*0.3);
warp_5=`
warp_6=`    float2 v1 = normalize(uv_orig-0.5);
warp_7=`    float2 v2 = v1.yx * float2(1,-1);
warp_8=`    
warp_9=`    float z = length(texsize.zw)*450;
warp_10=`
warp_11=`    v1 *= -length(texsize.zw)*450;
warp_12=`    v2 *= -length(texsize.zw)*400;
warp_13=`
warp_14=`    float2 uv_lq = uv + v1*texsize.zw*8;
warp_15=`    float2 uv_lq2 = uv + v2*texsize.zw*8;
warp_16=`    float2 uv_hq = uv + v1*texsize.zw*0;
warp_17=`    float2 uv_hq2 = uv + v2*texsize.zw*0;
warp_18=`
warp_19=`    ret.x = tex2D(sampler_main, uv_lq).x;
warp_20=`    ret.x += (tex2D(sampler_main, uv_hq).x - GetBlur3(uv).x)*1;
warp_21=`
warp_22=`    ret.y = tex2D(sampler_main, uv_lq2).y;
warp_23=`    ret.y += (tex2D(sampler_main, uv_hq2).y - GetBlur3(uv).y)*1;
warp_24=`
warp_25=`    float diff = 0.1;
warp_26=`//    ret.z = lerp(ret.x,ret.y,saturate(vol-vol_att+diff));
warp_27=`      ret.z = lerp(ret.x,ret.y,saturate(1-(bass+bass_att)*0.3));
warp_28=`
warp_29=`    ret.z += (tex2D(sampler_main, uv_orig).z - GetBlur1(uv).z)*0.02;
warp_30=`//    ret.z = 0;
warp_31=`}
comp_1=`shader_body
comp_2=`{
comp_3=`float2 uv1 = (uv-0.5)*aspect.xy;
comp_4=`
comp_5=`float rad2 = length(uv1) + 0.05;
comp_6=`float rad1 = 0.1/rad2 ;
comp_7=`
comp_8=`float2 uv2 = float2 (ang/3.14, rad1*2);
comp_9=`uv2.y = uv2.y  +0.1*time;
comp_10=`uv2.x = uv2.x  +0.1*time;
comp_11=`
comp_12=`float2 uv3 = float2 (ang/3.14, rad1*2);
comp_13=`uv3.y = uv3.y  +0.1*time ;
comp_14=`uv3.x = uv3.x  -0.1*time;
comp_15=`
comp_16=`float3 crisp = tex2D(sampler_main,uv2) + 2*tex2D(sampler_main,uv3);
comp_17=`crisp += 2*GetBlur2(frac(uv2)) + 2*GetBlur2(frac(uv3));
comp_18=`
comp_19=`float3 lay1 = float3 (0,0,1)*uv.y*pow(1-rad,8);
comp_20=`
comp_21=`crisp = 3* crisp * pow(rad,1);
comp_22=`
comp_23=`float mask = saturate(1-4*rad);
comp_24=`
comp_25=`ret = crisp + lay1*mask;
comp_26=`ret = pow(ret,0.8);
comp_27=`}
