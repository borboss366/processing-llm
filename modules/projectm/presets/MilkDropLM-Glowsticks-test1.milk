shape_0_per_frame1=t1 = time - int (time);
shape_0_per_frame2=sample = instance/num_inst;
shape_0_per_frame3=t_abs = sample*3;
shape_0_per_frame4=t_rel = sample-time/5;
shape_0_per_frame5=
shape_0_per_frame6=ampl = 2*t_abs/2 ;
shape_0_per_frame7=
shape_0_per_frame8=k1=sin(time/13);
shape_0_per_frame9=k2=sin(time/12);
shape_0_per_frame10=ox = ampl*sin (t_abs*63 + k1*63);
shape_0_per_frame11=oy = ampl*cos (t_abs*63 + k2*63);
shape_0_per_frame12=oz = ampl*sin (t_abs*95);
shape_0_per_frame13=
shape_0_per_frame14=
shape_0_per_frame15=r = sqr(sin(t_rel*3.4));
shape_0_per_frame16=g = sqr(sin(t_rel*2.3));
shape_0_per_frame17=b = sqr (cos(t_rel*1.5));
shape_0_per_frame18=
shape_0_per_frame19=//a=(0.1*(sin(t_abs*3)) + 0.6*q3*below (abs(1-t_rel),0.1))/ampl;
shape_0_per_frame20=
shape_0_per_frame21=x = ox/ampl + .5;
shape_0_per_frame22=y = oy/ampl + .5;
shape_0_per_frame23=z = oz/ampl + 1;
shape_0_per_frame24=
shape_0_per_frame25=//a = 0.02/abs(z-t_abs)/ampl;
shape_0_per_frame26=
shape_0_per_frame27=rad = .02/z;
shape_0_per_frame28=a=1/z;
