per_frame_init_1=i=0;  
per_frame_init_2=loop(10000, gmegabuf(i)=0;
per_frame_init_3=i=i+1;);
per_frame_init_4=
per_frame_init_5=t=0;
per_frame_init_6=
per_frame_init_7=q6=aspecty;
per_frame_1=chng=sin(time*.5);
per_frame_2=cthr=.9999;
per_frame_3=mq21=if(above(chng,cthr),rand(3),mq21);
per_frame_4=mq22=if(above(chng,cthr),rand(3),mq22);
per_frame_5=mq23=if(above(chng,cthr),rand(3),mq23);
per_frame_6=mq24=if(above(chng,cthr),rand(2),mq24);
per_frame_7=mq25=if(above(chng,cthr),rand(2),mq25);
per_frame_8=mq26=if(above(chng,cthr),rand(2),mq26);
per_frame_9=mq27=if(above(chng,cthr),rand(1),mq27);
per_frame_10=mq28=if(above(chng,cthr),rand(1),mq28);
per_frame_11=mq29=if(above(chng,cthr),rand(1)*.3,mq29);
per_frame_12=mq31=if(above(chng,cthr),rand(1)*.3,mq31);
per_frame_13=monitor=chng;
per_frame_14=q21=mq21;q22=mq22;q23=mq23;q24=mq24;q25=mq25;q26=mq26;
per_frame_15=q27=mq27;q28=mq28;q29=mq29;
per_frame_16=monitor=mq29;
per_frame_17=
per_frame_18=dec_med = pow (0.9, 30/fps);
per_frame_19=dec_slow = pow (0.99, 30/fps);
per_frame_20=beat = max (max (bass, mid), treb); 
per_frame_21=avg = avg*dec_slow + beat*(1-dec_slow);
per_frame_22=is_beat = above(beat, .5+avg+peak) * above (time, t0+.2);
per_frame_23=t0 = is_beat*time + (1-is_beat)*t0;
per_frame_24=peak = is_beat * beat + (1-is_beat)*peak*dec_med;
per_frame_25=index = (index + is_beat) %8;
per_frame_26=index2 = (index2 + is_beat*bnot(index))%8;
per_frame_27=
per_frame_28=q20 = avg;
per_frame_29=q21 = beat;
per_frame_30=q22 = peak;
per_frame_31=q23 = index;
per_frame_32=q24 = is_beat;
per_frame_33=q26 = bass + mid + treb;
per_frame_34=
per_frame_35=k1 =  is_beat*bnot(index)*bnot(index2);
per_frame_36=k2 =  is_beat*bnot(index)*index2;
per_frame_37=rot1 =  rot1 + k1;
per_frame_38=rot2 =  rot2 + k2;
per_frame_39=q17 = rot1;
per_frame_40=q18 = rot2;
per_frame_41=
per_frame_42=sumx = is_beat*xpos;
per_frame_43=sumy = is_beat*ypos;
per_frame_44=meantx = dec_med*meantx + (1-dec_med)*sumx/8;
per_frame_45=meanty = dec_med*meanty + (1-dec_med)*sumy/8;
per_frame_46=
per_frame_47=dx1 = 0.02*(sumx - 2*meantx);
per_frame_48=dy1 = 0.02*(sumy - 2*meanty);
per_frame_49=
per_frame_50=dx2 = dec_med*dx2 + (1-dec_med)*dx1;
per_frame_51=dy2 = dec_med*dy2 + (1-dec_med)*dy1;
per_frame_52=
per_frame_53=dx3 = dec_med*dx3 + (1-dec_med)*dx2;
per_frame_54=dy3 = dec_med*dy3 + (1-dec_med)*dy2;
per_frame_55=
per_frame_56=q11 = dx3;  q12 = dy3;
per_frame_57=q13 = dec_med;
per_frame_58=
per_frame_59=rota = rota*dec_med + q22/8*(1-dec_med);
per_frame_60=q14 = rota;
per_frame_61=
per_frame_62=c1 = c1*dec_slow + q21*0.2*(1-dec_slow);
per_frame_63=q15 = c1;
per_frame_64=
per_frame_65=zoom1 = 1.0 + q15/25;
per_frame_66=monitor = zoom1;
per_frame_67=q10 = asin(1)*0.5;
per_frame_68=q32=cos(time*2)*0.5+0.5;
per_frame_69=
per_frame_70=//begin beat code
per_frame_71=dec_med = pow(0.98, 30/fps);
per_frame_72=beat = max(max(bass,mid),treb);
per_frame_73=avg = avg*dec_med + beat*(1-dec_med);
per_frame_74=is_beat = above(beat, .5+avg+peak) * above(time, t0+.2);
per_frame_75=t0 = is_beat*time + (1-is_beat)*t0;
per_frame_76=peak = is_beat * beat + (1-is_beat)*peak*dec_med;
per_frame_77=index = (index + is_beat) %8;
per_frame_78=index2 = (index2 + is_beat*bnot(index))%8;
per_frame_79=
per_frame_80=q20 = avg;
per_frame_81=q21 = beat;
per_frame_82=q22 = peak;
per_frame_83=q23 = index;
per_frame_84=q24 = index2;
per_frame_85=q26 = is_beat;
per_frame_86=//end beat code
per_frame_87=
per_frame_88=t=t+1/fps;
per_frame_89=q1=time;
per_frame_90=q2=sin(0.1*time)*0.3;
per_frame_91=q3=0.5+0.2*sin(0.15*time);
per_frame_92=
per_frame_93=//polar coordinates in general:
per_frame_94=//http://en.wikipedia.org/wiki/Polar_coordinates
per_frame_95=
per_frame_96=//spherical coordinates:
per_frame_97=//http://en.wikipedia.org/wiki/Spherical_coordinates
per_frame_98=
per_frame_99=q27 = 10;  //radial division for the spiral, start at 1
per_frame_100=
per_frame_101=q28 = 1/fps;  //conversion factor for time differences a movement per second is independent of fps
per_frame_102=
per_frame_103=//these two define the current caleidoscope pattern, try different combinations:
per_frame_104=q31 = sin(2.1*time);  
per_frame_105=q32 = cos(2.1*time*0.8+0.5);
per_frame_106=
per_frame_107=//a = a*dec_med + (1-dec_med)*b;  //smooth transition, remove for snappier response
per_frame_108=
per_frame_109=a = max(q22,1);   b = 4.5;  //# of lines
per_frame_110=//c = c*dec_med + (1-dec_med)*sin(a*b);  //phase shift
per_frame_111=c = 0;
per_frame_112=d = d*dec_med + (1-dec_med)*cos(a*b);  //# of rotations
per_frame_113=d = 0.4;
per_frame_114=
per_frame_115=//project 3D spiral in polar coordinates, see also the caleidoscope code at the end
per_frame_116=len = 200;    angle = -1.5708;     rad = 0.025;     height = 0.4;      scale = 10;
per_frame_117=
per_frame_118=//project in spherical coordinates
per_frame_119=w = 0.25;   height = 0.3;    rad = 0.05;   len = 200;     angle = -1.5708; 
per_frame_120=
per_frame_121=p1 = scale*len*sin(angle)/rad;
per_frame_122=p2 = scale*(height+rad*cos(angle));
per_frame_123=p3 = scale*len*cos(angle)/rad;
per_frame_124=
per_frame_125=//rotate in x/y
per_frame_126=ang = q17*0.1;  c = cos(ang);  s = sin(ang);
per_frame_127=x1 = p1*c - p2*s;
per_frame_128=y1 = p1*s + p2*c;
per_frame_129=z1 = p3;
per_frame_130=
per_frame_131=ang = q18*0.1;  c = cos(ang);  s = sin(ang);
per_frame_132=x1 = p1*c - p2*s;
per_frame_133=y1 = p1*s + p2*c;
per_frame_134=z1 = p3;
per_frame_135=
per_frame_136=ang = q17*0.1;  c = cos(ang);  s = sin(ang);
per_frame_137=x2 = x1*c - z1*s;
per_frame_138=z2 = x1*s + z1*c;
per_frame_139=
per_frame_140=ang = q18*0.1;  c = cos(ang);  s = sin(ang);
per_frame_141=y2 = y1*c - z2*s;
per_frame_142=z2 = y1*s + z2*c;
per_frame_143=
per_frame_144=//perspective calculation
per_frame_145=fov = 0.6;   //larger values give less perspective, much smaller values become horizontal
per_frame_146=
per_frame_147=x = 0.5 + fov*x2/z2;
per_frame_148=y = 0.5 + fov*y2/z2;
per_frame_149=
per_frame_150=//push to the border
per_frame_151=x = x*0.6 + 0.2;
per_frame_152=y = y*0.6 + 0.2;
per_frame_153=
per_frame_154=q1 = p1;    q2 = p2;     q3 = p3;
per_frame_155=q4 = x1;    q5 = y1;     q6 = z1;
per_frame_156=q7 = x2;    q8 = y2;     q9 = z2;
