{
  "id": "plane",
  "name": "Plane",
  "description": "A small airplane that flies back and forth across the top of the canvas, reacting to live audio.",
  "version": "1.0.0",
  "oscPrefix": "plane",

  "layout": {
    "x": { "default": 0, "range": [0, 1], "description": "Horizontal anchor (0=left, 1=right)" },
    "y": { "default": 0.05, "range": [0, 1], "description": "Vertical anchor (0=top, 1=bottom)" },
    "width": { "default": 1.0, "range": [0.05, 1], "description": "Width as fraction of canvas" },
    "height": { "default": 0.15, "range": [0.05, 1], "description": "Height as fraction of canvas" },
    "anchor": {
      "default": "top-left",
      "values": ["top-left", "top-center", "top-right", "center", "bottom-left", "bottom-center", "bottom-right"]
    },
    "zOrder": { "default": 10, "range": [-100, 100], "description": "Draw order — lower renders behind" }
  },

  "physics": {},

  "params": {
    "planeColor": {
      "default": "#e0e0e0",
      "type": "color",
      "description": "Aircraft fill colour",
      "osc": true
    },
    "planeSize": {
      "default": 40,
      "range": [20, 120],
      "type": "int",
      "description": "Half-length of fuselage in pixels",
      "osc": true
    },
    "baseSpeed": {
      "default": 3.0,
      "range": [0.5, 10],
      "description": "Horizontal speed at rest, pixels per frame",
      "osc": true
    },
    "speedBoost": {
      "default": 1.5,
      "range": [0, 4],
      "description": "Multiplier on speed by smoothedLevel",
      "osc": true
    },
    "bobAmplitude": {
      "default": 8.0,
      "range": [0, 30],
      "description": "Vertical bob amplitude on bass",
      "osc": true
    },
    "bassSmoothing": {
      "default": 0.07,
      "range": [0.02, 0.3],
      "description": "lerp factor toward bassEnergy",
      "osc": true
    }
  },

  "effects": {
    "dipOnBeat": {
      "default": true,
      "description": "Plane dips momentarily on each beat",
      "osc": true
    }
  }
}
