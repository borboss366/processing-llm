{
  "id": "ceilingfan",
  "name": "Ceiling Fan",
  "description": "A three-blade ceiling fan in the top-right corner that spins faster with louder music.",
  "version": "1.0.0",
  "oscPrefix": "ceilingfan",

  "layout": {
    "x": { "default": 0.9, "range": [0, 1], "description": "Horizontal anchor (0=left, 1=right)" },
    "y": { "default": 0.1, "range": [0, 1], "description": "Vertical anchor (0=top, 1=bottom)" },
    "width": { "default": 0.2, "range": [0.05, 1], "description": "Subject width as fraction of canvas" },
    "height": { "default": 0.2, "range": [0.05, 1], "description": "Subject height as fraction of canvas" },
    "anchor": { "default": "center", "values": ["top-left", "top-center", "top-right", "center", "bottom-left", "bottom-center", "bottom-right"] },
    "zOrder": { "default": 5, "range": [-100, 100], "description": "Draw order — lower renders behind" }
  },

  "physics": {},

  "params": {
    "bladeColor":     { "default": "#0066cc", "type": "color",                 "description": "Blade fill colour",                    "osc": true },
    "baseSize":       { "default": 40,        "type": "int", "range": [20, 120],   "description": "Half-length of blade in pixels at rest",  "osc": true },
    "spinRate":       { "default": 0.03,                       "range": [0.005, 0.15],     "description": "Base rotation speed (radians per frame)",        "osc": true },
    "spinMultiplier": { "default": 1.5,                       "range": [0.5, 4],    "description": "Multiplier for bass-driven spin speed",        "osc": true },
    "bladeWidth":     { "default": 0.2,                        "range": [0.05, 0.5],      "description": "Width of each blade as fraction of baseSize", "osc": true },
    "bassSmoothing":  { "default": 0.07,                      "range": [0.02, 0.3],"description": "lerp factor toward bassEnergy",          "osc": true }
  },

  "effects": {
    "spinOnBass": { "default": true, "description": "Spin with smoothed bass", "osc": true }
  }
}
