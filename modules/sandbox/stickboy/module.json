{
  "id": "stickboy",
  "name": "Stickboy",
  "description": "Audio-reactive blue stick figure boy waving hands to the music.",
  "version": "1.0.0",
  "oscPrefix": "stickboy",

  "layout": {
    "x": { "default": 0.75, "range": [0, 1], "description": "Horizontal anchor (0=left, 1=right)" },
    "y": { "default": 0.5, "range": [0, 1], "description": "Vertical anchor (0=top, 1=bottom)" },
    "width": { "default": 0.25, "range": [0.05, 1], "description": "Subject width as fraction of canvas" },
    "height": { "default": 0.3, "range": [0.05, 1], "description": "Subject height as fraction of canvas" },
    "anchor": { "default": "center", "values": ["top-left", "top-center", "top-right", "center", "bottom-left", "bottom-center", "bottom-right"] },
    "zOrder": { "default": 0, "range": [-100, 100], "description": "Draw order — lower renders behind" }
  },

  "physics": {},

  "params": {
    "bodyColor":     { "default": "#0000ff", "type": "color",                 "description": "Body fill colour",                    "osc": true },
    "handColor":     { "default": "#0000ff", "type": "color",                 "description": "Hand fill colour",                           "osc": true },
    "baseSize":      { "default": 60,        "type": "int", "range": [20, 200],   "description": "Half-height of body in pixels at rest",  "osc": true },
    "waveStrength":  { "default": 1.0,                       "range": [0, 3],     "description": "Multiplier for bass-driven hand wave",        "osc": true },
    "jumpStrength":  { "default": 7.0,                       "range": [0, 20],    "description": "Initial upward velocity on beat",        "osc": true },
    "bassSmoothing": { "default": 0.07,                      "range": [0.02, 0.3],"description": "lerp factor toward bassEnergy",          "osc": true }
  },

  "effects": {
    "waveOnBass": { "default": true, "description": "Wave hands with smoothed bass", "osc": true }
  }
}
