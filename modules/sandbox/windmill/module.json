{
  "id": "windmill",
  "name": "Windmill",
  "description": "Small windmill in the bottom-left corner with four spinning blades that speed up with the music.",
  "version": "1.0.0",
  "oscPrefix": "windmill",

  "layout": {
    "x": { "default": 0.1, "range": [0, 1], "description": "Horizontal anchor (0=left, 1=right)" },
    "y": { "default": 0.9, "range": [0, 1], "description": "Vertical anchor (0=top, 1=bottom)" },
    "width": { "default": 0.25, "range": [0.05, 1], "description": "Subject width as fraction of canvas" },
    "height": { "default": 0.3, "range": [0.05, 1], "description": "Subject height as fraction of canvas" },
    "anchor": { "default": "center", "values": ["top-left", "top-center", "top-right", "center", "bottom-left", "bottom-center", "bottom-right"] },
    "zOrder": { "default": 5, "range": [-100, 100], "description": "Draw order — lower renders behind" }
  },

  "physics": {},

  "params": {
    "bladeColor":     { "default": "#4a90e2", "type": "color",                 "description": "Blade fill colour",                    "osc": true },
    "baseSize":       { "default": 60,        "type": "int", "range": [20, 200],   "description": "Half-height of body in pixels at rest",  "osc": true },
    "spinRate":       { "default": 0.025,                      "range": [0.005, 0.15],   "description": "Base rotation speed (radians per frame)",        "osc": true },
    "spinMultiplier": { "default": 1.0,                        "range": [0, 4.0],       "description": "Multiplier for volume-driven spin acceleration", "osc": true },
    "bladeLength":    { "default": 0.8,                       "range": [0.3, 1.2],    "description": "Relative length of blades",        "osc": true },
    "bassSmoothing":  { "default": 0.07,                      "range": [0.02, 0.3],"description": "lerp factor toward bassEnergy",          "osc": true }
  },

  "effects": {
    "spinOnBass": { "default": true, "description": "Blades spin faster with bass energy", "osc": true }
  }
}
