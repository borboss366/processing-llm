{
  "id": "carrot",
  "name": "Carrot",
  "description": "Audio-reactive dancing carrot mascot.",
  "oscPrefix": "carrot",
  "oscParams": [
    {
      "address": "/carrot/bodyColor",
      "name": "bodyColor",
      "label": "Body Color",
      "section": "params",
      "type": "color",
      "default": "#ff8c00",
      "description": "Carrot body fill colour"
    },
    {
      "address": "/carrot/leafColor",
      "name": "leafColor",
      "label": "Leaf Color",
      "section": "params",
      "type": "color",
      "default": "#28a040",
      "description": "Leaf fill colour"
    },
    {
      "address": "/carrot/baseSize",
      "name": "baseSize",
      "label": "Base Size",
      "section": "params",
      "type": "int",
      "default": 60,
      "description": "Half-height of carrot body in pixels at rest",
      "range": [
        20,
        200
      ]
    },
    {
      "address": "/carrot/swayStrength",
      "name": "swayStrength",
      "label": "Sway Strength",
      "section": "params",
      "type": "int",
      "default": 1,
      "description": "Multiplier for bass-driven horizontal sway",
      "range": [
        0,
        3
      ]
    },
    {
      "address": "/carrot/jumpStrength",
      "name": "jumpStrength",
      "label": "Jump Strength",
      "section": "params",
      "type": "int",
      "default": 7,
      "description": "Initial upward velocity on beat (pixels/frame)",
      "range": [
        0,
        20
      ]
    },
    {
      "address": "/carrot/bassSmoothing",
      "name": "bassSmoothing",
      "label": "Bass Smoothing",
      "section": "params",
      "type": "float",
      "default": 0.07,
      "description": "lerp factor toward bassEnergy — lower = smoother",
      "range": [
        0.02,
        0.3
      ]
    },
    {
      "address": "/carrot/tiltOnBass",
      "name": "tiltOnBass",
      "label": "Tilt On Bass",
      "section": "effects",
      "type": "boolean",
      "default": true,
      "description": "Rotate the carrot tilt with smoothed bass"
    }
  ],
  "controller": [
    {
      "id": "params",
      "title": "Parameters",
      "controls": [
        {
          "type": "color",
          "label": "Body Color",
          "address": "/carrot/bodyColor",
          "default": "#ff8c00"
        },
        {
          "type": "color",
          "label": "Leaf Color",
          "address": "/carrot/leafColor",
          "default": "#28a040"
        },
        {
          "type": "slider",
          "label": "Base Size",
          "address": "/carrot/baseSize",
          "min": 20,
          "max": 200,
          "step": 1,
          "default": 60
        },
        {
          "type": "slider",
          "label": "Sway Strength",
          "address": "/carrot/swayStrength",
          "min": 0,
          "max": 3,
          "step": 1,
          "default": 1
        },
        {
          "type": "slider",
          "label": "Jump Strength",
          "address": "/carrot/jumpStrength",
          "min": 0,
          "max": 20,
          "step": 1,
          "default": 7
        },
        {
          "type": "slider",
          "label": "Bass Smoothing",
          "address": "/carrot/bassSmoothing",
          "min": 0.02,
          "max": 0.3,
          "step": 0.01,
          "default": 0.07
        }
      ]
    },
    {
      "id": "effects",
      "title": "Effects",
      "controls": [
        {
          "type": "toggle",
          "label": "Tilt On Bass",
          "address": "/carrot/tiltOnBass",
          "default": true
        }
      ]
    }
  ],
  "baked": [
    {
      "name": "x",
      "value": 0.5,
      "type": "float",
      "description": "Horizontal anchor (0=left, 1=right)"
    },
    {
      "name": "y",
      "value": 0.5,
      "type": "float",
      "description": "Vertical anchor (0=top, 1=bottom)"
    },
    {
      "name": "width",
      "value": 0.2,
      "type": "float",
      "description": "Subject width as fraction of canvas"
    },
    {
      "name": "height",
      "value": 0.3,
      "type": "float",
      "description": "Subject height as fraction of canvas"
    },
    {
      "name": "anchor",
      "value": "center",
      "type": "string",
      "description": ""
    },
    {
      "name": "zOrder",
      "value": 0,
      "type": "int",
      "description": "Draw order — lower renders behind"
    }
  ]
}